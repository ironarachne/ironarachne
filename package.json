{
  "name": "ironarachne",
  "version": "1.13.0",
  "private": true,
  "type": "module",
  "scripts": {
    "render:room": "tsx scripts/render_room.ts",
    "render:layout": "tsx scripts/render_layout.ts",
    "render:dungeon": "vite-node scripts/render_dungeon.ts",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --compiler-warnings \"css_unused_selector:ignore\"",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch --compiler-warnings \"css_unused_selector:ignore\"",
    "test": "vitest run",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint ."
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "dependencies": {
    "@ironarachne/made-up-names": "^2.3.7",
    "@ironarachne/rng": "^2.3.1",
    "@ironarachne/word-generator": "^2.3.1",
    "@ironarachne/words": "^2.0.0",
    "@sveltejs/adapter-node": "^5.2.9",
    "@sveltejs/kit": "^2.5.27",
    "core-js": "^3.33.3",
    "d3": "^7.6.1",
    "d3-delaunay": "^6.0.2",
    "priorityqueuejs": "^2.0.0",
    "three": "^0.179.1",
    "xmlbuilder2": "^3.1.1"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.0",
    "@eslint/js": "^9.39.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.1",
    "@tsconfig/svelte": "^5.0.2",
    "@types/core-js": "^2.5.8",
    "@types/d3": "^7.1.0",
    "@types/d3-delaunay": "^6.0.0",
    "@types/node": "^24",
    "@types/priorityqueuejs": "^1.0.4",
    "@types/three": "^0.179.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.13.1",
    "globals": "^16.5.0",
    "postcss": "^8.4.33",
    "prettier": "^3.7.4",
    "prettier-plugin-svelte": "^3.4.0",
    "sass": "^1.69.7",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.48.1",
    "vite": "^6.3.5",
    "vite-plugin-glsl": "^1.3.1",
    "vitest": "^3.1.4"
  }
}
