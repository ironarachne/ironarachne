{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npx --no-install prettier *)",
      "Bash(npx prettier *)",
      "Bash(npx eslint *)",
      "Bash(npx vitest *)",
      "Bash(npx playwright *)",
      "Bash(npx svelte-check *)",
      "Bash(npx svelte-kit *)",
      "Bash(npx tsc *)",
      "Bash(npx vite *)",
      "Bash(npx vite-node *)",
      "Bash(npx tsx *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git add *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git rev-parse *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(gh issue reopen *)",
      "Bash(gh label list *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "for d in . \"${CLAUDE_PROJECT_DIR:-.}\"; do s=\"$d/.claude/hooks/guard_protected_branch.sh\"; [ -f \"$s\" ] && exec bash \"$s\"; done; exit 0",
            "timeout": 10,
            "statusMessage": "Checking branch"
          },
          {
            "type": "command",
            "command": "for d in . \"${CLAUDE_PROJECT_DIR:-.}\"; do s=\"$d/.claude/hooks/scan_staged_secrets.sh\"; [ -f \"$s\" ] && exec bash \"$s\"; done; exit 0",
            "timeout": 15,
            "statusMessage": "Scanning staged changes for secrets"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path // empty' | { read -r f || exit 0; npx --no-install prettier --write --ignore-unknown \"$f\"; } >/dev/null 2>&1 || true",
            "timeout": 30,
            "statusMessage": "Formatting"
          }
        ]
      }
    ]
  }
}
